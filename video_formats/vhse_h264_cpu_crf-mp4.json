{
    "main_pass": [
        "-n", "-c:v", "libx264",
        "-preset", ["cpu_preset", [
            "ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow"
        ], {"default": "medium"}],
        "-crf", ["cq", "INT", {"default": 19, "min": 0, "max": 51}],
        "-pix_fmt", "yuv420p",
        "-vf", ["vhse_filter", "STRING", {"default": "scale=out_color_matrix=bt709,setsar=1"}],
        "-color_range", "tv", "-colorspace", "bt709",
        "-color_primaries", "bt709", "-color_trc", "bt709",
        "-movflags", "+faststart", "-fps_mode", "cfr"
    ],
    "fake_trc": "bt709",
    "dim_alignment": 1,
    "save_metadata": "False",
    "extension": "mp4"
}
